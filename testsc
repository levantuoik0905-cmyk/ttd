local function rebuild(b)
	if not lib or type(b)~="table" then return nil end
	if type(lib.Packet)=="function" then
		local o,r=pcall(lib.Packet,b) if o then return r end
		local o2,r2=pcall(lib.Packet,lib,b) if o2 then return r2 end
	end
	if type(lib.new_packet)=="function" then
		local o,r=pcall(lib.new_packet,lib,131,b) if o then return r end
	end
	return nil
end
local function sendPkt(e)
	if not lib then return false end
	if pcall(function() lib.send(lib,e.p) end) then return true end
	if pcall(function() lib.send(e.p) end) then return true end
	local np=rebuild(e.b)
	if np then return pcall(function() lib.send(lib,np) end) end
	return false
end
local function onPkt(p)
	pcall(function()
		if #pkts>=8 then return end
		local id local a1,b1=pcall(function() return p.PacketId end) local a2,b2=pcall(function() return p.id end)
		if a1 and type(b1)=="number" then id=b1 elseif a2 and type(b2)=="number" then id=b2 end
		if id~=131 then return end
		local by local a3,b3=pcall(function() return p:AsArray() end) local a4,b4=pcall(function() return p.AsArray(p) end)
		if a3 and b3 then by=b3 elseif a4 and b4 then by=b4 end
		if type(by)~="table" then return end
		local len=#by
		if len==0 or len>400 then return end
		local k=table.concat(by,",")
		for _,e in ipairs(pkts) do if e.k==k then return end end
		pkts[#pkts+1]={p=p,b=by,k=k}
		targetLbl.Text="PKT #"..#pkts.." "..len.."b"
		status.Text="da bat "..#pkts
	end)
end
local function tryHook(t,tag)
	if not t or type(t)=="function" then return false end
	for _,n in ipairs({"add_send_hook","addSendHook","add_outgoing_hook","addOutgoingHook","HookOutgoing","hook_outgoing","on_send","onSend","hook","Hook"}) do
		local ok,v=pcall(function() return t[n] end)
		if ok and type(v)=="function" then
			local o,e=pcall(function() t[n](t,onPkt) end)
			if not o then o,e=pcall(function() t[n](onPkt) end) end
			print(tag.."."..n.." -> "..(o and "OK" or ("LOI "..tostring(e))))
			if o then return true end
		end
	end
	for _,n in ipairs({"Capture","capture","SendHook"}) do
		local ok,v=pcall(function() return t[n] end)
		if ok and v then
			local o,e
			if type(v)=="function" then o,e=pcall(function() t[n](t,onPkt) end)
			elseif type(v)=="table" or type(v)=="userdata" then o,e=pcall(function() v:Connect(onPkt) end) end
			print(tag.."."..n.." -> "..(o and "OK" or ("LOI "..tostring(e))))
			if o then return true end
		end
	end
	return false
end
