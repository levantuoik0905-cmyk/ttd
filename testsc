local function mkBtn(txt,y,x,w,h,fn)
	local b=new("TextButton",{Size=UDim2.fromOffset(w,h),Position=UDim2.fromOffset(x,y),BackgroundColor3=Color3.fromRGB(46,49,60),TextColor3=Color3.fromRGB(235,235,242),TextSize=13,Font=Enum.Font.GothamBold,BorderSizePixel=0,Text=txt},frame)
	local last=0
	b.InputBegan:Connect(function(i)
		if not isTap(i) then return end
		local t=os.clock() if t-last<0.25 then return end
		last=t pcall(fn)
	end)
	return b
end
