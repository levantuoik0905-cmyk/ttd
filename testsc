local function readGem()
	local best=0
	pcall(function()
		local ls=LP:FindFirstChild("leaderstats")
		if ls then for _,v in ipairs(ls:GetChildren()) do local n=v:IsA("ValueBase") and tonumber(v.Value) if n and n>best then best=n end end end
		for _,d in ipairs(PG:GetDescendants()) do if d:IsA("TextLabel") and d.Text:lower():find("gem") then local n=tonumber((d.Text:gsub("[^%d]",""))) if n and n>best then best=n end end end
	end)
	return best
end
